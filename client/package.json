{
  "name": "@entropydrop/space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "generate:protobuf": "npm --prefix ../engine run generate:protobuf",
    "check:protobuf": "npm --prefix ../engine run check:protobuf",
    "docs:generate": "npm --prefix ../engine run docs:generate",
    "docs:check": "npm --prefix ../engine run docs:check",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:docs": "node tools/check-doc-links.mjs",
    "check": "npm run check:engine && npm run typecheck && npm run check:docs && npm run test:app && npm run build",
    "audit:deps": "npm audit --audit-level=high",
    "preview": "vite preview",
    "test": "npm run test:engine && npm run test:app",
    "check:engine": "npm --prefix ../engine run check",
    "test:engine": "npm --prefix ../engine test",
    "test:app": "node --import ./test/setup.ts --test --test-concurrency=1 \"test/*.test.ts\"",
    "dev": "vite"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "three": "^0.183.2",
    "@entropydrop/space-engine": "file:../engine"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "exports": {
    "./api-keys": "./src/bootstrap/SpaceApiKeyClient.ts",
    "./agent-guide": "./src/bootstrap/SpaceAgentGuide.ts"
  }
}
