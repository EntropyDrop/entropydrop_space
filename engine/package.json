{
  "name": "@entropydrop/space-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./testing/setup": "./test/setup.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "generate:protobuf": "node ../tools/generate-protobuf.mjs",
    "check:protobuf": "node ../tools/generate-protobuf.mjs --check",
    "check:buf": "BUF_CACHE_DIR=../.buf-cache buf lint ../proto",
    "docs:generate": "node ../tools/generate-api-docs.ts",
    "docs:check": "node ../tools/generate-api-docs.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/setup.ts --test --test-concurrency=1 \"test/*.test.ts\"",
    "check": "npm run check:script-sdk && node ../tools/build-terrain-wasm.mjs --check && node ../tools/build-geometry-wasm.mjs --check && npm run check:protobuf && npm run check:buf && npm run docs:check && npm run typecheck && npm test",
    "generate:script-sdk": "node ../tools/build-entity-script-sdk.mjs",
    "check:script-sdk": "node ../tools/build-entity-script-sdk.mjs --check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "acorn": "^8.18.0",
    "simplex-noise": "^4.0.3",
    "assemblyscript": "0.28.20",
    "binaryen": "131.0.0-nightly.20260721"
  },
  "peerDependencies": {
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@types/node": "^24.10.1",
    "@types/three": "^0.183.1",
    "three": "^0.183.2",
    "ts-proto": "2.12.1",
    "typescript": "~5.9.3"
  },
  "imports": {
    "#entity-script-compiler": {
      "browser": "./src/scripting/AssemblyScriptCompiler.browser.ts",
      "default": "./src/scripting/AssemblyScriptCompiler.node.ts"
    }
  }
}
